<%- include('../../components/layout/page-head', { pageName: 'users' }) %>
<%
const isEdit = !!userId;
const parentCrumb = { label: 'จัดการผู้ใช้งาน', href: `/${prefix}/views/users` };
const topbarActions = [
    { btnClass: 'p-btn p-btn-sky p-btn-sm', icon: 'save', label: 'บันทึก', onClick: "document.getElementById('userForm').requestSubmit()" },
];
%>
<%- include('../../components/admin-shell/shell-open', { activeView: 'users', pageTitle: isEdit ? 'แก้ไขบุคลากร' : 'เพิ่มบุคลากรใหม่', parentCrumb: parentCrumb, topbarActions: topbarActions }) %>

                <!-- VIEW: User form -->
                <section id="view-user-form" class="um-view active" data-user-id="<%= userId ?? '' %>">
                    <!-- No form-header here — the topbar breadcrumb already shows the
                         page name and doubles as the "back" affordance (its parent
                         crumb links to the list). Capped-width column (see
                         --page-max-width in theme.css), same idea as Frappe/ERPNext's
                         .std-form-layout, fields stack one per row (.um-form-stack). -->
                    <div class="um-form-narrow">
                        <form id="userForm" onsubmit="handleUserFormSubmit(event)">
                            <article class="um-form-section">
                                <div class="um-form-stack">
                                    <%- include('../../components/ui/field', { id: 'frmUsername', label: 'ชื่อผู้ใช้งาน (Username)', required: true }) %>
                                    <%- include('../../components/ui/field', { id: 'frmEmployeeId', label: 'รหัสพนักงาน', required: true }) %>
                                    <%- include('../../components/ui/field', { id: 'frmFullName', label: 'ชื่อ-นามสกุล', required: true }) %>
                                    <%- include('../../components/ui/field', { id: 'frmEmail', label: 'อีเมล', type: 'email' }) %>
                                    <%- include('../../components/ui/field', { id: 'frmDepartment', label: 'แผนก/สังกัด' }) %>
                                    <div class="p-field">
                                        <label for="frmStatus">สถานะ</label>
                                        <select id="frmStatus">
                                            <option value="pending">Pending</option>
                                            <option value="active">Active</option>
                                            <option value="suspended">Suspended</option>
                                        </select>
                                    </div>
                                    <%- include('../../components/ui/field', { id: 'frmExpiredAt', label: 'วันหมดอายุบัญชี (เว้นว่าง = ไม่จำกัดเวลา)', type: 'date' }) %>
                                </div>
                            </article>
                        </form>
                    </div>
                </section>

<%- include('../../components/admin-shell/shell-close') %>

    <%- include('../../components/ui/temp-password-modal') %>

<%- include('../../components/layout/page-foot', { pageName: 'users' }) %>
