<%- include('../../components/layout/page-head', { pageName: 'print-templates' }) %>
<%
const isEdit = !!printTemplateId;
const parentCrumb = { label: 'เทมเพลตพิมพ์เอกสาร', href: `/${prefix}/views/print-templates` };
const topbarActions = [
    { btnClass: 'p-btn p-btn-sky p-btn-sm', icon: 'save', label: 'บันทึก', onClick: "document.getElementById('printTemplateForm').requestSubmit()" },
];
%>
<%- include('../../components/admin-shell/shell-open', { activeView: 'print-templates', pageTitle: isEdit ? 'แก้ไขเทมเพลต' : 'สร้างเทมเพลตใหม่', parentCrumb: parentCrumb, topbarActions: topbarActions }) %>

                <!-- VIEW: Print template form -->
                <section id="view-print-template-form" class="um-view active" data-print-template-id="<%= printTemplateId ?? '' %>">
                    <%- include('../../components/ui/form-header', {
                        backHref: `/${prefix}/views/print-templates`,
                        titleId: 'printTemplateFormTitle',
                        subtitleText: 'กำหนดรหัสเทมเพลต ขนาดกระดาษ ตัวแปร และเนื้อหา HTML ที่จะส่งให้ Gotenberg แปลงเป็น PDF',
                    }) %>

                    <form id="printTemplateForm" onsubmit="handlePrintTemplateFormSubmit(event)">
                        <!-- Two tabs, not one long scroll: "รายละเอียด" (identity/render
                             config — filled once, rarely revisited) vs. "รายงาน" (the
                             actual template design workspace — parameters/mock data +
                             HTML/JS/Preview editor, where an admin editing an existing
                             template spends nearly all their time). Defaults to whichever
                             tab is actually relevant: "รายละเอียด" when creating new (every
                             field there still needs filling in), "รายงาน" when editing
                             (skip straight to the editor). -->
                        <div class="um-page-tabs" role="tablist">
                            <button type="button" id="printTemplateTab-details" class="um-page-tab<% if (!isEdit) { %> active<% } %>" data-tab="details" role="tab" aria-selected="<%= isEdit ? 'false' : 'true' %>" aria-controls="printTemplatePanel-details" onclick="switchPrintTemplateTab('details')">รายละเอียด</button>
                            <button type="button" id="printTemplateTab-report" class="um-page-tab<% if (isEdit) { %> active<% } %>" data-tab="report" role="tab" aria-selected="<%= isEdit ? 'true' : 'false' %>" aria-controls="printTemplatePanel-report" onclick="switchPrintTemplateTab('report')">รายงาน</button>
                        </div>

                        <div id="printTemplatePanel-details" class="um-tab-panel<% if (isEdit) { %> hidden<% } %>" data-tab-panel="details" role="tabpanel" aria-labelledby="printTemplateTab-details">
                            <article class="um-form-section">
                                <div class="um-form-grid">
                                    <%- include('../../components/ui/field', { id: 'frmTemplateCode', label: 'รหัสเทมเพลต', required: true, extraClass: 'um-mono-input', placeholder: 'เช่น invoice' }) %>
                                    <%- include('../../components/ui/field', { id: 'frmTemplateNameTh', label: 'ชื่อเทมเพลต (ไทย)', required: true }) %>
                                    <%- include('../../components/ui/field', { id: 'frmTemplateNameEn', label: 'ชื่อเทมเพลต (English)', required: true }) %>
                                    <div class="p-field um-field-checkbox">
                                        <label><input type="checkbox" id="frmTemplateActive" checked> เปิดใช้งาน (Active)</label>
                                    </div>
                                </div>
                                <div class="um-form-grid">
                                    <div class="p-field">
                                        <label for="frmTemplatePaperSize">ขนาดกระดาษ</label>
                                        <select id="frmTemplatePaperSize">
                                            <option value="A4">A4</option>
                                            <option value="A5">A5</option>
                                            <option value="Letter">Letter</option>
                                            <option value="Legal">Legal</option>
                                        </select>
                                    </div>
                                    <div class="p-field">
                                        <label for="frmTemplateOrientation">แนวกระดาษ</label>
                                        <select id="frmTemplateOrientation">
                                            <option value="portrait">แนวตั้ง (Portrait)</option>
                                            <option value="landscape">แนวนอน (Landscape)</option>
                                        </select>
                                    </div>
                                    <div class="p-field">
                                        <label for="frmTemplateEngine">เอนจิน</label>
                                        <select id="frmTemplateEngine">
                                            <option value="simple">Simple — แทนที่ {{key}} ตรงๆ</option>
                                            <option value="banded">Banded — แบ่งหน้าอัตโนมัติ</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="um-form-grid um-form-grid-half">
                                    <%- include('../../components/ui/field', { id: 'frmTemplateDescriptionTh', label: 'คำอธิบาย (ไทย)', rows: 2 }) %>
                                    <%- include('../../components/ui/field', { id: 'frmTemplateDescriptionEn', label: 'คำอธิบาย (English)', rows: 2 }) %>
                                </div>
                            </article>
                        </div>

                        <div id="printTemplatePanel-report" class="um-tab-panel<% if (!isEdit) { %> hidden<% } %>" data-tab-panel="report" role="tabpanel" aria-labelledby="printTemplateTab-report">
                        <article class="um-form-section">
                            <div id="templateParametersSection">
                                <div class="um-section-header-row">
                                    <div>
                                        <h3 class="um-section-title">ตัวแปร (Parameters)</h3>
                                        <p class="um-muted-note">
                                            ตัวแปรที่ใช้ในเนื้อหา HTML ด้วย <code>&lbrace;&lbrace;key&rbrace;&rbrace;</code> — ไม่ส่งค่ามาจะใช้ค่าเริ่มต้นแทน
                                        </p>
                                    </div>
                                    <button type="button" class="p-btn p-btn-ghost p-btn-sm" onclick="addPrintTemplateParameterRow()">
                                        <i data-lucide="plus" class="um-icon-sm"></i> เพิ่มตัวแปร
                                    </button>
                                </div>
                                <div id="templateParametersContainer" class="um-parameters-list"></div>
                            </div>

                            <div class="hidden" id="templateMockDataSection">
                                <div class="um-section-header-row">
                                    <div>
                                        <h3 class="um-section-title">Mock Data (JSON)</h3>
                                        <p class="um-muted-note">
                                            ข้อมูลตัวอย่างแบบ nested object/array ตามที่ band template ใช้ — เป็น <code>params</code> ของ Live Preview และ "Generate Test PDF"
                                        </p>
                                    </div>
                                    <div class="um-editor-toolbar">
                                        <button type="button" class="p-btn p-btn-ghost p-btn-sm" onclick="formatPrintTemplateMockData()">
                                            <i data-lucide="sparkles" class="um-icon-sm"></i> Format
                                        </button>
                                        <button type="button" class="p-btn p-btn-ghost p-btn-sm" id="templateMockDataFullscreenBtn" onclick="toggleMockDataFullscreen()">
                                            <i data-lucide="maximize" class="um-icon-sm"></i> Fullscreen
                                        </button>
                                    </div>
                                </div>
                                <div id="templateMockDataEditorMount" class="um-mockdata-editor-mount"></div>
                                <span id="templateMockDataError" class="um-field-error hidden"></span>
                            </div>
                        </article>

                        <article class="um-form-section" id="templateHtmlSection">
                            <div class="um-section-header-row">
                                <h3 class="um-section-title">เนื้อหา HTML</h3>
                                <div class="um-editor-toolbar">
                                    <div class="um-view-toggle" role="group" aria-label="โหมดการแสดงผล">
                                        <button type="button" class="p-btn p-btn-ghost p-btn-sm um-view-toggle-btn active" data-view-mode="split" onclick="setPrintTemplateViewMode('split')">
                                            <i data-lucide="columns-3" class="um-icon-sm"></i> Split
                                        </button>
                                        <button type="button" class="p-btn p-btn-ghost p-btn-sm um-view-toggle-btn" data-view-mode="code" onclick="setPrintTemplateViewMode('code')">
                                            <i data-lucide="code" class="um-icon-sm"></i> Code
                                        </button>
                                        <button type="button" class="p-btn p-btn-ghost p-btn-sm um-view-toggle-btn" data-view-mode="preview" onclick="setPrintTemplateViewMode('preview')">
                                            <i data-lucide="eye" class="um-icon-sm"></i> Preview
                                        </button>
                                    </div>
                                    <button type="button" class="p-btn p-btn-ghost p-btn-sm hidden" id="printTemplateGeneratePdfBtn" onclick="generatePrintTemplateTestPdf()">
                                        <i data-lucide="file-output" class="um-icon-sm"></i> Generate Test PDF
                                    </button>
                                    <button type="button" class="p-btn p-btn-ghost p-btn-sm" id="printTemplateFullscreenBtn" onclick="togglePrintTemplateFullscreen()">
                                        <i data-lucide="maximize" class="um-icon-sm"></i> Fullscreen
                                    </button>
                                </div>
                            </div>
                            <p class="um-muted-note">
                                ผลลัพธ์จริงจาก Gotenberg แสดงทางขวา — ลากเส้นแบ่งเพื่อปรับขนาดพื้นที่ได้ เอนจิน Banded จะมีคอลัมน์ JavaScript แทรกกลางไว้ override
                                <code>paginator.inline.js</code> กลาง เฉพาะเทมเพลตที่ต้องการกฎการตัดหน้าต่างจากปกติ (ปล่อยว่างไว้เพื่อใช้ตัวกลาง)
                            </p>
                            <div id="templateTestParamsContainer" class="um-test-params-row hidden"></div>
                            <div id="templateEditorSplit" class="um-editor-split">
                                <div class="um-editor-pane" id="templateEditorPane">
                                    <label class="um-editor-pane-label" for="templateHtmlEditorMount">HTML Editor</label>
                                    <div id="templateHtmlEditorMount" class="um-html-editor-mount"></div>
                                </div>
                                <div id="templateEditorResizer" class="um-editor-resizer" role="separator" aria-orientation="vertical" aria-label="ปรับขนาดพื้นที่ระหว่าง HTML กับ JavaScript" tabindex="0"></div>
                                <div class="um-editor-pane hidden" id="templateJsPane">
                                    <label class="um-editor-pane-label" for="templateJsEditorMount">Paginator JavaScript (ขั้นสูง)</label>
                                    <div id="templateJsEditorMount" class="um-html-editor-mount"></div>
                                </div>
                                <div id="templateJsResizer" class="um-editor-resizer hidden" role="separator" aria-orientation="vertical" aria-label="ปรับขนาดพื้นที่ระหว่าง JavaScript กับ Preview" tabindex="0"></div>
                                <div class="um-editor-pane" id="templatePreviewPane">
                                    <span class="um-editor-pane-label">
                                        Live Preview
                                        <span id="templatePreviewLoading" class="um-preview-loading hidden" role="status">กำลังสร้างตัวอย่าง…</span>
                                    </span>
                                    <div class="um-preview-viewport">
                                        <!-- src is a blob: URL of the actual Gotenberg-rendered PDF (see
                                             updatePreview() in print-templates.service.js) — the browser's
                                             native PDF viewer renders it, so this is WYSIWYG with real print
                                             output instead of a browser-only approximation of the raw HTML. -->
                                        <iframe id="templatePreviewFrame" class="um-preview-frame" title="Live PDF preview"></iframe>
                                        <div id="templatePreviewSkeleton" class="um-preview-skeleton is-visible" aria-hidden="true">
                                            <div class="um-skeleton-line" style="width:55%"></div>
                                            <div class="um-skeleton-line" style="width:35%"></div>
                                            <div class="um-skeleton-line" style="width:70%"></div>
                                            <div class="um-skeleton-block"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>
                        </div>
                    </form>
                </section>

<%- include('../../components/admin-shell/shell-close') %>
<%- include('../../components/layout/page-foot', { pageName: 'print-templates' }) %>
