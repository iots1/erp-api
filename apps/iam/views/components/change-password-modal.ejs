<!-- Mandatory password change (no close button — must_change_password stays
     true, and AuthGuard blocks every other endpoint, until this succeeds).
     Triggered right after login when /auth/me reports must_change_password,
     and as a fallback whenever any API call comes back 403 MUST_CHANGE_PASSWORD.
     handleChangePasswordSubmit is bridged to window by each page's
     controller/public-api.js; see change-password.service.js. -->
<dialog id="changePasswordModal" data-persistent>
    <article>
        <h3>ต้องตั้งรหัสผ่านใหม่</h3>
        <p>บัญชีนี้ใช้รหัสผ่านชั่วคราว กรุณาตั้งรหัสผ่านใหม่ก่อนใช้งานต่อ</p>
        <form id="changePasswordForm" onsubmit="handleChangePasswordSubmit(event)">
            <%- include('ui/field', { id: 'changePwCurrent', label: 'รหัสผ่านปัจจุบัน (หรือรหัสผ่านชั่วคราว)', type: 'password', required: true, autocomplete: 'current-password' }) %>
            <%- include('ui/field', { id: 'changePwNew', label: 'รหัสผ่านใหม่ (อย่างน้อย 8 ตัวอักษร)', type: 'password', required: true, autocomplete: 'new-password' }) %>
            <%- include('ui/field', { id: 'changePwConfirm', label: 'ยืนยันรหัสผ่านใหม่', type: 'password', required: true, autocomplete: 'new-password' }) %>
            <p id="changePasswordError" class="auth-modal-error hidden"></p>
            <button type="submit" class="p-btn p-btn-lavender auth-modal-submit">บันทึกรหัสผ่านใหม่</button>
        </form>
    </article>
</dialog>
