<!-- Back-button header for a form view. Locals: titleId, subtitleText, plus
     exactly one of:
     - backView: switchView target, for a form nested inside a list view via
       client-side sub-view switching (policies).
     - backHref: a real URL, for a form that is its own server route and
       navigates back to the list page (roles/new, roles/:id/edit).
     No title text here — the topbar breadcrumb (see admin-shell/topbar.ejs)
     already shows the exact same string as its current crumb, same reasoning
     layout.css's .um-toolbar-right comment documents for list-page toolbars
     ("now that um-view-title is gone, the breadcrumb already shows the page
     name"). `titleId` is kept so pages that still reference it via JS (e.g.
     document.title wiring) don't need updating — it now lands on the
     subtitle, the only text this component renders. -->
<div class="um-form-header">
    <% if (typeof backHref !== 'undefined') { %>
    <a href="<%= backHref %>" class="um-icon-btn"><i data-lucide="arrow-left"></i></a>
    <% } else { %>
    <button type="button" class="um-icon-btn" onclick="switchView('<%= backView %>')"><i data-lucide="arrow-left"></i></button>
    <% } %>
    <p id="<%= titleId %>" class="um-view-subtitle"><%= subtitleText %></p>
</div>
