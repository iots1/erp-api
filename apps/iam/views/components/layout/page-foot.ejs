<!-- Shared page shell (bottom half). Locals: pageName (matches page-head.ejs).
     Pair with components/layout/page-head.ejs. -->
    <!-- Resolve #loginScreen vs #appShell synchronously, before first paint,
         same trick page-head.ejs uses for the dark-theme flash: both start
         `hidden` in markup so a logged-in user doesn't see the login screen
         flash on every route change while bundle.js (deferred to the end of
         body) is still loading. Kept in sync with isAuthenticated() in
         login.service.js and re-applied there by shell.service.js's
         bootAdminPage — this is just the pre-JS-load guess. -->
    <script>
        (function () {
            try {
                var raw = localStorage.getItem('iam_view.session.v1');
                var session = raw ? JSON.parse(raw) : null;
                var authenticated = Boolean(session && session.csrf_token && session.user);
                document.getElementById('loginScreen').classList.toggle('hidden', authenticated);
                document.getElementById('appShell').classList.toggle('hidden', !authenticated);
            } catch (e) {}
        })();
    </script>
    <!-- Sidebar scroll restore — sidebar.ejs renders .um-sidebar-nav with an
         inline visibility:hidden, cleared here. Must run *after* the block
         above un-hides #appShell: until then the whole shell is
         `display: none`, so the nav has no layout box and assigning scrollTop
         is silently discarded. Still synchronous and pre-paint (reading
         scrollTop forces the pending layout), so the nav's first painted frame
         is already at the saved offset instead of jumping from 0. The save
         side (on nav-item click) lives in page-head.ejs. -->
    <script>
        (function () {
            var nav = document.querySelector('.um-sidebar-nav');
            if (!nav) return;
            try {
                var saved = sessionStorage.getItem('iam_sidebar_scroll');
                if (saved !== null) nav.scrollTop = parseInt(saved, 10);
            } catch (e) {
                // Ignore — an unreadable sessionStorage just means no restore.
            } finally {
                // Always reveal, even when unauthenticated (the shell is hidden
                // now, but login.service.js un-hides it in place later — a nav
                // left visibility:hidden would stay invisible after login).
                nav.style.visibility = '';
            }
        })();
    </script>
    <div id="toastStack" class="p-toast-stack"></div>
    <div id="loadingOverlay" class="p-loading-overlay hidden">
        <div class="p-loading-spinner"></div>
        <p id="loadingOverlayMessage" class="p-loading-message"></p>
    </div>

    <%- include('../auth-modal') %>
    <%- include('../change-password-modal') %>
    <%- include('../ui/confirm-dialog') %>

    <%- include('../../pages/user-management/components/config') %>
    <script src="/<%= prefix %>/assets/pages/<%= pageName %>/js/bundle.js?v=<%= assetVersion %>"></script>
</body>
</html>
