<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8" />
<title>Invoice <%= invoice_no %></title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  body {
    font-family: "Noto Sans Thai", "Noto Sans", Arial, sans-serif;
    color: #1f2937;
    padding: 40px 48px;
    font-size: 13px;
    line-height: 1.5;
  }
  .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px; }
  .brand h1 { margin: 0 0 4px; font-size: 22px; color: #111827; }
  .brand p { margin: 0; color: #6b7280; }
  .doc-title { text-align: right; }
  .doc-title h2 { margin: 0; font-size: 26px; letter-spacing: 2px; color: #2563eb; }
  .doc-title p { margin: 4px 0 0; color: #6b7280; }
  .meta-grid { display: flex; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .meta-box { flex: 1; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px 16px; }
  .meta-box h3 { margin: 0 0 6px; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #9ca3af; }
  .meta-box p { margin: 0; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
  thead th {
    background: #2563eb; color: #fff; text-align: left;
    padding: 10px 12px; font-size: 12px; text-transform: uppercase;
  }
  thead th.num, tbody td.num { text-align: right; }
  tbody td { padding: 10px 12px; border-bottom: 1px solid #e5e7eb; }
  tbody tr:nth-child(even) { background: #f9fafb; }
  .totals { width: 280px; margin-left: auto; }
  .totals div { display: flex; justify-content: space-between; padding: 6px 12px; }
  .totals .grand { font-weight: 700; font-size: 15px; border-top: 2px solid #111827; color: #111827; }
  .note { margin-top: 32px; padding: 14px 16px; background: #f9fafb; border-radius: 8px; color: #4b5563; }
  .footer { margin-top: 40px; text-align: center; color: #9ca3af; font-size: 11px; }
</style>
</head>
<body>
  <div class="header">
    <div class="brand">
      <h1><%= seller.name_th %></h1>
      <p><%= seller.name_en %></p>
      <p><%= seller.address_th %></p>
      <p>เลขประจำตัวผู้เสียภาษี: <%= seller.tax_id %></p>
    </div>
    <div class="doc-title">
      <h2>INVOICE</h2>
      <p>ใบแจ้งหนี้</p>
      <p><strong>#<%= invoice_no %></strong></p>
    </div>
  </div>

  <div class="meta-grid">
    <div class="meta-box">
      <h3>ลูกค้า / Bill To</h3>
      <p><strong><%= customer.name_th %></strong></p>
      <p><%= customer.name_en %></p>
      <p><%= customer.address_th %></p>
    </div>
    <div class="meta-box">
      <h3>รายละเอียด / Details</h3>
      <p>วันที่ออกเอกสาร: <%= invoice_date %></p>
      <p>ครบกำหนดชำระ: <%= due_date %></p>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>รายการ / Description</th>
        <th class="num">จำนวน</th>
        <th class="num">ราคา/หน่วย</th>
        <th class="num">จำนวนเงิน</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(item) { %>
      <tr>
        <td><%= item.description_th %><br/><span style="color:#9ca3af;font-size:11px;"><%= item.description_en %></span></td>
        <td class="num"><%= item.quantity %></td>
        <td class="num"><%= item.unit_price_formatted %></td>
        <td class="num"><%= item.amount_formatted %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>

  <div class="totals">
    <div><span>รวมเป็นเงิน</span><span><%= subtotal_formatted %></span></div>
    <div><span>ภาษีมูลค่าเพิ่ม <%= vat_rate %>%</span><span><%= vat_formatted %></span></div>
    <div class="grand"><span>ยอดรวมสุทธิ</span><span><%= total_formatted %> บาท</span></div>
  </div>

  <% if (note_th || note_en) { %>
  <div class="note">
    <% if (note_th) { %><p><%= note_th %></p><% } %>
    <% if (note_en) { %><p><%= note_en %></p><% } %>
  </div>
  <% } %>

  <div class="footer">
    เอกสารนี้สร้างโดยระบบอัตโนมัติ · Generated by ERP report-bc via Gotenberg
  </div>
</body>
</html>
